{
  "name": "applyflow-desktop",
  "version": "2.2.11",
  "private": true,
  "description": "ApplyFlow Desktop — truthful, ATS-optimized resumes and one-click applications on Dice and Jobright (Greenhouse, Lever, Ashby), with every application, resume and recruiter contact in a local SQLite database.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && electron .",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "render": "node dist-cli/applyflow-render.mjs",
    "dist:win": "node scripts/build.mjs && node scripts/package-win.mjs",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "docx": "^9.15.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "idb": "^8.0.4",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "productName": "ApplyFlow",
  "author": {
    "name": "ApplyFlow"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.applyflow.desktop",
    "productName": "ApplyFlow",
    "copyright": "ApplyFlow — not affiliated with Dice or Jobright",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**",
      "dist-electron/**",
      "build/icon.png",
      "build/icons/16x16.png",
      "build/icons/24x24.png",
      "build/icons/32x32.png",
      "build/icons/48x48.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApplyFlow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    },
    "publish": null
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/your-account/applyflow-desktop.git"
  }
}
